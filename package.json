{
  "name": "vynt",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:desktop",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "dev:web": "vite --mode web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:web": "npm run typecheck && vite build --mode web",
    "build:desktop": "npm run typecheck && vite build && electron-builder",
    "build:win": "npm run typecheck && vite build && electron-builder --win --x64 --publish never",
    "test:e2e": "playwright test",
    "preview:web": "vite preview --host 0.0.0.0",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2"
  },
  "main": "dist-electron/main.js",
  "description": "A local-first Y2K photo booth with live canvas filters and microphone video recording.",
  "author": "Yash Tripathi",
  "homepage": "https://github.com/Yash-Tripath1/Vynt",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yash-Tripath1/Vynt.git"
  }
}
