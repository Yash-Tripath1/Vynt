{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.yashtripathi.vynt",
  "productName": "VYNT",
  "asar": true,
  "compression": "maximum",
  "directories": { "output": "release/${version}", "buildResources": "assets" },
  "files": ["dist/**/*", "dist-electron/**/*", "!**/*.map"],
  "electronLanguages": ["en-US"],
  "win": {
    "icon": "assets/vynt.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": "always",
    "shortcutName": "VYNT"
  },
  "mac": {
    "target": ["dmg"],
    "extendInfo": {
      "NSCameraUsageDescription": "VYNT uses your camera to create photos and videos locally on your device.",
      "NSMicrophoneUsageDescription": "VYNT uses your microphone only when you choose to record video with MIC ON."
    }
  },
  "linux": { "target": ["AppImage"], "icon": "public/vynt.png", "category": "Graphics" }
}
